{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "*.cpp",
                "-I${SPDLOG_HOME}/include",
                "-L${SPDLOG_HOME}/build",
                "-I${PUGIXML_HOME}/src",
                "-L${PUGIXML_HOME}/build",
                "-I${NLOHMANN_HOME}/include",
                "-I${CLI11_HOME}/include",
                "-I${YAML_CPP_HOME}/include",
                "-L${YAML_CPP_HOME}/build",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lpugixml",
                "-lyaml-cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}